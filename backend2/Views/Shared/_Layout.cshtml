<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Backend2</title>
    <!-- Bootstrap CSS для стилизации шапки и отступов -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        .navbar {
            background-color: #212529;
            padding: 0.8rem 1rem;
        }
        .navbar-brand, .nav-link {
            color: #fff !important;
        }
        .nav-link {
            opacity: 0.75;
            margin-left: 15px;
        }
        .nav-link:hover {
            opacity: 1;
        }
        footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #e5e5e5;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- Верхняя навигационная панель -->
    <header>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-3">
        <div class="container-fluid ms-4">
            <a class="navbar-brand me-4" asp-controller="Calc" asp-action="Index">Backend2</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link text-white-50" asp-controller="Calc" asp-action="Index">Home</a>
                </li>
            </ul>
        </div>
    </nav>
    </header>

    <!-- Основное содержимое страницы -->
    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>

        <!-- Подвал -->
        <footer>
            <p>&copy; 2026 - Backend2</p>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
