<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; margin: 0; padding: 0; }
        header { background-color: #222; padding: 15px 20px; }
        header a { color: #999; text-decoration: none; margin-right: 20px; font-size: 16px; }
        header .brand { color: #fff; font-size: 18px; }
        .container { padding: 20px 40px; }
        footer { padding: 20px 0; color: #666; border-top: 1px solid #ddd; margin: 40px 40px 0 40px; font-size: 14px; }
        a { color: #007bff; text-decoration: none; }
        a:hover { text-decoration: underline; }
        ul { padding-left: 40px; }
        h2 { font-weight: normal; margin-top: 0; }
    </style>
</head>
<body>
    <header>
        <a class="brand" asp-controller="Home" asp-action="Index">Backend1</a>
        <a asp-controller="Home" asp-action="Index">Home</a>
    </header>
    <div class="container">
        @RenderBody()
    </div>
    <footer>
        &copy; 2026 - Backend1
    </footer>
</body>
</html>
